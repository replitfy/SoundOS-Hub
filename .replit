modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WIX_SITE_ID = "17fbd65b-01a2-47cc-932d-5af322d3df54"
HABLLA_WORKSPACE_ID = "6acf941287abecfba71d287d"
HABLLA_INSTAGRAM_CONNECTION_ID = "6acf946887abecfba71d2881"
HABLLA_WHATSAPP_CONNECTION_ID = "6af07823cb07a3bc46160f77"

[userenv.production]
PUBLIC_APP_URL = "https://soundfulness.net"
